generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProviderId {
  resend
}

enum ConversationStatus {
  open
  archived
}

enum MessageDirection {
  inbound
  outbound
}

/// App-level role. super_admin configures connections/mailboxes/grants (and future teams).
/// member uses only granted mailboxes.
enum AppRole {
  super_admin
  member
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String   @map("password_hash")
  role               AppRole  @default(super_admin)
  preferredMailboxId String?  @map("preferred_mailbox_id")
  createdAt          DateTime @default(now()) @map("created_at")

  sessions            Session[]
  providerConnections ProviderConnection[]
  conversations       Conversation[]
  mailboxGrants       MailboxGrant[]
  preferredMailbox    Mailbox?             @relation("UserPreferredMailbox", fields: [preferredMailboxId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model ProviderConnection {
  id                     String     @id @default(cuid())
  userId                 String     @map("user_id")
  provider               ProviderId
  apiKeyEncrypted        String     @map("api_key_encrypted")
  webhookSecretEncrypted String?    @map("webhook_secret_encrypted")
  config                 Json       @default("{}")
  isActive               Boolean    @default(true) @map("is_active")
  createdAt              DateTime   @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  mailboxes     Mailbox[]

  @@index([userId])
  @@map("provider_connections")
}

/// Address on a provider connection (e.g. ricky@domain.com). Owned by connection, not a single user.
model Mailbox {
  id           String   @id @default(cuid())
  connectionId String   @map("connection_id")
  email        String
  displayName  String?  @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")

  connection       ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  grants           MailboxGrant[]
  messages         Message[]
  preferredByUsers User[]             @relation("UserPreferredMailbox")

  @@unique([connectionId, email])
  @@index([email])
  @@map("mailboxes")
}

/// Access grant: either a direct user (one-to-one) or a future team. Exactly one subject should be set.
model MailboxGrant {
  id        String   @id @default(cuid())
  mailboxId String   @map("mailbox_id")
  userId    String?  @map("user_id")
  /// Reserved for future Team model — team-based mailbox access.
  teamId    String?  @map("team_id")
  createdAt DateTime @default(now()) @map("created_at")

  mailbox Mailbox @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mailboxId, userId])
  @@unique([mailboxId, teamId])
  @@index([userId])
  /// Exact grant checks: userId + mailboxId
  @@index([userId, mailboxId])
  @@index([teamId])
  @@map("mailbox_grants")
}

model Conversation {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  connectionId  String             @map("connection_id")
  subject       String
  participants  String
  status        ConversationStatus @default(open)
  unread        Boolean            @default(false)
  lastMessageAt DateTime           @default(now()) @map("last_message_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, unread])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  conversationId    String           @map("conversation_id")
  direction         MessageDirection
  fromAddress       String           @map("from_address")
  toAddresses       String           @map("to_addresses")
  /// Normalized "our side" address for mailbox filtering (inbound received-for / outbound from).
  ourAddress        String?          @map("our_address")
  mailboxId         String?          @map("mailbox_id")
  subject           String
  bodyHtml          String?          @map("body_html")
  bodyText          String?          @map("body_text")
  providerMessageId String           @map("provider_message_id")
  messageIdHeader   String?          @map("message_id_header")
  inReplyTo         String?          @map("in_reply_to")
  headers           Json?
  sentAt            DateTime         @default(now()) @map("sent_at")
  connectionId      String           @map("connection_id")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mailbox      Mailbox?     @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@unique([connectionId, providerMessageId])
  @@index([conversationId, sentAt])
  @@index([messageIdHeader])
  @@index([inReplyTo])
  @@index([ourAddress])
  @@index([mailboxId])
  /// Speeds Sent folder: direction=outbound + mailboxId IN (...)
  @@index([mailboxId, direction])
  /// Speeds Sent fallback when matching ourAddress
  @@index([ourAddress, direction])
  @@map("messages")
}

model Attachment {
  id                   String  @id @default(cuid())
  messageId            String  @map("message_id")
  filename             String
  contentType          String? @map("content_type")
  size                 Int?
  providerAttachmentId String? @map("provider_attachment_id")
  /// Private Vercel Blob pathname. Null until the bytes are copied.
  blobPathname         String? @map("blob_pathname")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}
