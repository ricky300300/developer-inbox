# Runtime / app queries — Supabase Transaction pooler (port 6543) is fine here
DATABASE_URL="postgresql://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations / Prisma CLI — use Direct connection (port 5432), NOT :6543
# Supabase → Project Settings → Database → Connection string → URI (Direct)
# Example: postgresql://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:password@db.PROJECT_REF.supabase.co:5432/postgres"

# 32-byte key for AES-256-GCM encryption of provider secrets.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Optional. Webhook URLs in Settings are built from the request Host by default.
# Set this only when you need to advertise a different public URL (e.g. you browse
# via localhost but Resend must hit an ngrok tunnel).
# NEXT_PUBLIC_APP_URL="https://your-subdomain.ngrok-free.app"
