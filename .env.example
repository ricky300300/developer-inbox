# Supabase Postgres connection string (use the pooler URL for serverless)
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres"

# 32-byte key for AES-256-GCM encryption of provider secrets.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Public app URL used to display webhook endpoints in Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
